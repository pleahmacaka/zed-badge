{
  "name": "zed-badge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Realtime download badges for Zed extensions, styled after zed.dev",
  "license": "MIT",
  "author": "PleahMaCaka",
  "repository": {
    "type": "git",
    "url": "https://github.com/PleahMaCaka/zed-badge.git"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:fixtures": "ZED_API=http://localhost:8787/extensions vite dev",
    "fixtures": "bun scripts/fixture-server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome check --write .",
    "lint": "biome check ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/lilex": "^5.3.0",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify/svelte": "^5.2.2",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.4",
    "badge-maker": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.3.14",
    "daisyui": "^5.0.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16"
  }
}
